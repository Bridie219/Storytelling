    {
      "start_time": 23,
      "end_time": 32,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "She slowly turns around to investigate why she felt the cold of snow on her fingertips, and then quickly looks back, to make sure no one is following her. It's almost like she doesn't want to get into trouble for going somewhere she isn't supposed to go. "
            }
          ]
        }
      ],
