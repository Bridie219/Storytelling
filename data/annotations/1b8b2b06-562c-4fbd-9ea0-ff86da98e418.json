    {
      "start_time": 33,
      "end_time": 75,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Lucy is completely enthralled by the winter wonderland she's found through the doorway in the wardrobe. She can't believe that it was waiting for her, hiding in a wardrobe, of all things. "
            }
          ]
        }
      ],
