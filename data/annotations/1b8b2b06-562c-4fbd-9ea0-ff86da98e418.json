        }
      ],
      "uuid": "96d156a7-3982-4c68-a752-5de187b4ae96"
    },
    {
      "start_time": 33,
      "end_time": 75,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Lucy is completely enthralled by the winter wonderland she's found through the doorway in the wardrobe. She can't believe that it was waiting for her, hiding in a wardrobe, of all things. She has found the portal to Narnia."
            }
          ]
        }
      ],
      "tags": [
        {
          "category": "Genres",
          "tag": "Fantasy"
        },
        {
          "category": "Forms",
          "tag": "Movie"
        },
        {
