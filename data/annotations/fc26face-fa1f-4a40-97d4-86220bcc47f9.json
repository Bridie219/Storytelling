    },
    {
      "start_time": 923,
      "end_time": 966,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Jude embarasses Cardan in front of his friends and his family. The tournament makes him look bad, because he was bested by a mortal. She beat a Faerie in battle, and earned herself renown. "
            }
          ]
        }
      ],
      "tags": [
