    },
    {
      "start_time": 111,
      "end_time": 151,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "The rules of the fantasy world Jude has found herself in are that everyone is on their own, and anyone can betray anyone. It becomes clear very quickly that Jude's main focus is the survival of herself and her family. "
            }
          ]
        }
      ],
