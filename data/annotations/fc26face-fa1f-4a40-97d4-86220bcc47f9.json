    },
    {
      "start_time": 830,
      "end_time": 835,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Cardan's sword pointing at Jude is symbolic of his choice to target Jude during this tournament. It is a threat and a last warning. If she fails to leave the tournament, he will not be responsible for his actions. "
            }
          ]
        }
      ],
      "tags": [
