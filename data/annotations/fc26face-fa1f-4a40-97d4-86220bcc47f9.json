      "end_time": 110,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Despite the story taking place in a realm called Faerie, the story is not a fairytale. It is a much darker story, closer to the mythology of faeries from Ireland. "
            }
          ]
        }
      ],
