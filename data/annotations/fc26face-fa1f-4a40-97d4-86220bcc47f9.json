      "end_time": 261,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "The close-up of Jude's hand reveals the rowan berries she wears on a bracelet. These prevent faeries from being able to control her using a glamour. As long as she wears the rowan berries, her free will is protected."
            }
          ]
        }
      ],
