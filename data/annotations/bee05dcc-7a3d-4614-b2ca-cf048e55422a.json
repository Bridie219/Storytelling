    {
      "start_time": 76,
      "end_time": 89,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "The reference to the First Army as cannon fodder is accurate. They are sent through the Shadow Fold as they are viewed as expendable. They are the most replaceable, but Grisha are very powerful and few, and must be protected. "
            }
          ]
        }
