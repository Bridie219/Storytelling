      ],
      "uuid": "b669ca13-cd53-4e62-9a3b-2c9b010f522c"
    },
    {
      "start_time": 63,
      "end_time": 75,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "The conflicts between Ravka, Fjerda and Shu Han are lightly inspired by the conflicts between Russia, Europe and Asia during World War II. "
            }
          ]
        }
      ],
