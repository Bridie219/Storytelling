    {
      "start_time": 23,
      "end_time": 27,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Each clip further explores the conflicts going on in the world of Shadow and Bone, including military clashes, magical battles, and the knife fights amidst the darkness of the Shadow Fold. Each sequence helps to further build the complex political landscape within Shadow and Bone, and the realm of Ravka."
            }
          ]
        }
      ],
